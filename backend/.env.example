# LLM Provider Configuration
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Models (Use provider/model format)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional overrides. Leave blank to use OPENROUTER_MODEL for every task.
OPENROUTER_STUDY_PLAN_MODEL=
OPENROUTER_REVIEW_MODEL=

# LangSmith Tracing Configuration
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=campus-ai-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Embeddings (local, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database
DATABASE_URL=sqlite+aiosqlite:///./campus_ai.db

# ChromaDB
CHROMADB_PATH=./data/chroma_db
CHROMADB_COLLECTION=campus_ai_docs

# RAG Settings
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.1
CONVERSATION_HISTORY_WINDOW=10

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# API
FRONTEND_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Demo Mode (uses mock responses if no API key configured)
DEMO_MODE=false

# Authentication
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
